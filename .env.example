# Copy this file to .env.local (already gitignored) to set values locally.

# Optional: your contact email, sent to OpenAlex as the `mailto` param for
# their "polite pool" (more consistent response times). Not required.
VITE_OPENALEX_MAILTO=

# Optional: Firebase project config, from your Firebase console's Web App
# settings (Firebase Hosting Spark/free plan — no Cloud Functions or Cloud
# Storage needed). All six must be set for sign-in and "Save project" to
# turn on; with any missing, that UI stays hidden and the rest of the app
# (search, maps, exports) still works with no login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: mailto link shown on the "Pro plan coming soon" message once a
# free user hits their 3-saved-project cap.
VITE_PRO_WAITLIST_EMAIL=
